{
  "name": "tofan-nfc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:comments && npm run lint:boundaries",
    "lint:comments": "node scripts/check-no-comments.mjs",
    "lint:boundaries": "sheriff verify",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "serve:ssr:tofan-nfc": "node dist/tofan-nfc/server/server.mjs",
    "serve:ssr": "ng build && node --env-file=ssr.env dist/tofan-nfc/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@softarc/sheriff-core": "^0.19.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24"
  }
}
